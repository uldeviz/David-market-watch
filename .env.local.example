# === Dashboard (Vercel) — variabili pubbliche, lette dal browser ===
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...la-anon-key-pubblica

# === Ingestion (GitHub Actions) — segrete, MAI nel browser ===
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...la-service-role-key-segreta

TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

RESEND_API_KEY=re_...
ALERT_EMAIL_TO=tuamail@esempio.com
ALERT_EMAIL_FROM=Market Watch <alerts@resend.dev>

# Soglia impact_score (0-100) sopra la quale si invia un alert push
ALERT_THRESHOLD=50

# --- Opzionali (hanno un default sensato, decommenta solo se vuoi cambiarli) ---
# LOOKBACK_MINUTES=20        # quanto indietro guardare nei feed RSS ad ogni run
# CONFIRM_WINDOW_MINUTES=45  # oltre questa eta' un evento PENDING diventa INCONCLUSIVE
# NOISE_THRESHOLD_PCT=0.05   # sotto questa % di movimento non conta come conferma
